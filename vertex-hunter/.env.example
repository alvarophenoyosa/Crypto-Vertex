# Optional runtime settings; defaults are suitable for local development.
PORT=3000
DATA_DIR=./data

# Recommended for a public deployment. Use a long random secret.
# Leave blank for local-only development.
DASHBOARD_TOKEN=

# Public MEXC market-data endpoints (no API keys required).
MEXC_REST_BASE=https://contract.mexc.com
MEXC_WS_URL=wss://contract.mexc.com/edge
